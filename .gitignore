# Virtual Environment
.venv/
venv/
ENV/
env/

# Explicitly ensure source code is tracked
!src/
!src/**

# Data Directories, Archives & Datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
workforce-risk-text-data/
workforce-risk-text-data.zip
*.parquet
*.csv
*.arrow
*.zip
*.tar
*.tar.gz
*.json
!configs/*.json
!reports/*.json
!reports/**/*.json
!reports/*.csv
!reports/**/*.csv
!frontend/*.json
!frontend/**/*.json
!deployment/*.json
!*.jsonl

# Model Artifacts, Checkpoints & Weights
artifacts/
deployment/artifacts/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Hugging Face & Cache Directories
.cache/
hf_cache/

# Python & Testing Caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
src/*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary Files
logs/
*.log
scratch/

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & Environment Variables
.env
.env.*
!.env.example

# Node / Frontend Caches & Artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Deployment folder (not commited on Github due to memory constraints)
deployment/