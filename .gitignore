# Virtual Environment
.venv/
venv/
ENV/
env/

# Data Directories (Raw, Processed, and Split datasets must NEVER be committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
*.parquet
*.csv
*.arrow
*.json
!configs/*.json
!reports/**/*.json
!*.jsonl

# Model Artifacts, Checkpoints & Weights
artifacts/
/models/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Hugging Face & Cache Directories
.cache/
hf_cache/

# Python & Testing Caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
src/*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary Files
logs/
*.log
scratch/

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets & Environment Variables
.env
.env.*
!.env.example
